# Copy this to .env and fill in your values

# Gemini Flash API key (free tier: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# URL of the main backend FastAPI service (no trailing slash)
BACKEND_URL=http://localhost:8000

# Meta WhatsApp Cloud API (test number credentials from Meta Developer Console)
WHATSAPP_TOKEN=your_whatsapp_permanent_system_user_token
WHATSAPP_PHONE_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=any_random_string_you_choose

# CORS: comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Optional: override cascade/config constants for demo
CASCADE_SECONDS=30
ENABLE_RESCUE_DEALS=true
ENABLE_DIVERSION=true
