# MongoDB Atlas Configuration
MONGODB_URI=mongodb://localhost:27017/surplus2shelter
DB_NAME=surplus2shelter

# External APIs
LLM_API_KEY=mock_key
WHATSAPP_CLOUD_API_TOKEN=mock_token
WHATSAPP_PHONE_NUMBER_ID=mock_phone_id

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://surplus2shelter.vercel.app"]

# Feature Flags
ENABLE_REWARDS=true
ENABLE_RESCUE_DEALS=true
ENABLE_DIVERSION=true
ENABLE_CHAT=true

# Engine & Reward Thresholds
CASCADE_TIMEOUT_SECONDS=180
REWARDS_DAILY_CAP=500
MEAL_KG=0.4
MAX_SEARCH_RADIUS_KM=20.0
